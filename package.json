{
  "name": "restaurant-platform",
  "version": "0.1.15",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/fetch-font.mjs",
    "dev": "tsx watch src/server.ts",
    "dev:admin": "vite --config admin/vite.config.ts",
    "build:admin": "vite build --config admin/vite.config.ts",
    "build:server": "tsc -p tsconfig.json",
    "build": "npm run build:admin && npm run build:server",
    "start": "node dist/server.js",
    "db:migrate": "node dist/db/migrate.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^8.3.0",
    "drizzle-orm": "^0.44.5",
    "fastify": "^5.6.0",
    "ioredis": "^5.7.0",
    "minio": "^8.0.6",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "license": "SEE LICENSE IN LICENSE.md"
}
