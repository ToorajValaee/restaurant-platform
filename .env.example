NODE_ENV=production
INSTANCE_NAME=cucinetta
APP_VERSION=0.1.4
APP_PORT=3101
APP_URL=https://cucinetta.ir

DATABASE_URL=postgresql://cucinetta:password@postgres:5432/cucinetta
REDIS_URL=redis://redis:6379
REDIS_PREFIX=cucinetta:

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=cucinetta

SESSION_SECRET=CHANGE_ME_LONG_RANDOM_VALUE
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

OTP_SECRET=CHANGE_ME_OTHER_RANDOM_VALUE
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=
SMSIR_TEMPLATE_PARAM=CODE

COOKIE_SECURE=true
